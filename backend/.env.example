NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_NAME=fieldforce
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432


# =========================
# Default Admin Seed
# =========================
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_NAME=System Admin
DEFAULT_ADMIN_EMAIL=admin@zforce.com
DEFAULT_ADMIN_PASSWORD=12345

# =========================
# Auth / Security
# =========================
JWT_SECRET=supersecret
JWT_EXPIRES_IN=7d

# =========================
# CORS (important for Web + Mobile)
# =========================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:19006,http://localhost:8081

# =========================
# Face Service (Python FastAPI)
# =========================
# FACE_SERVICE_URL=http://localhost:7001

FACE_SERVICE_URL=http://127.0.0.1:7001
FACE_SERVICE_TIMEOUT_MS=45000
# FACE_ANALYZE_TIMEOUT_MS=20000
# FACE_VERIFY_TIMEOUT_MS=20000
# FACE_ENROLL_TIMEOUT_MS=45000

# Face service speed/safety
FACE_ANALYZE_TIMEOUT_MS=30000
FACE_VERIFY_TIMEOUT_MS=45000
FACE_ENROLL_TIMEOUT_MS=90000
FACE_FAST_VERIFY_TIMEOUT_MS=12000




# FACE_VERIFY_TIMEOUT_MS=20000
# FACE_ENROLL_TIMEOUT_MS=45000

# FACE_VERIFY_ENDPOINT=/verify
# FACE_ENROLL_ENDPOINT=/enroll

# =========================
# Uploads / Receipts (optional)
# =========================
APP_BASE_URL=http://localhost:5000